{
  "name": "jscad-to-manifold",
  "version": "0.0.1",
  "description": "Convert jscad-planner trees to solids using an injected manifold-3d module",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/jscad-to-manifold"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "earcut": "^3.0.2",
    "jscad-planner": "^0.0.19"
  },
  "devDependencies": {
    "@jscad/modeling": "^2.13.0",
    "@types/bun": "^1.3.8",
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.0.0",
    "manifold-3d": "^3.5.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
